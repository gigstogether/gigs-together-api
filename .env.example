# Full reference: docs/configuration/ENVIRONMENT.md
# Set NODE_ENV through the launch command or deployment, not in this template.

# MongoDB connection (required at API startup).
# This URI is for the bundled local Docker replica set; replace it for other databases.
MONGO_URI=mongodb://localhost:27017/gigs-together?replicaSet=rs0&directConnection=true
# Optional Docker-only local host port (default: 27017); use the same port in MONGO_URI.
# The database name is configured only in MONGO_URI.
MONGO_DOCKER_HOST_PORT=27017

# Required at API startup.
JWT_SECRET=
JWT_REFRESH_SECRET=
BOT_TOKEN=
BOT_SECRET=
MAIN_CHAT_ID=
MAIN_CHANNEL_ID=
ALERTS_TELEGRAM_CHANNEL_ID=
TELEGRAM_OIDC_CLIENT_ID=
# Required BotFather Direct Mini App short names; these are example values, not defaults.
TELEGRAM_SUGGEST_MINI_APP_SHORT_NAME=suggest
TELEGRAM_ADMIN_MINI_APP_SHORT_NAME=admin

# Required for intake and moderation posts, respectively.
INTAKE_CHANNEL_ID=
MODERATION_CHANNEL_ID=

# Optional server port and cache refresh intervals (milliseconds).
PORT=
ADMIN_CACHE_TTL_MS=
TRANSLATION_CACHE_TTL_MS=
LOCALE_ACTIVE_CACHE_TTL_MS=

# Optional JWT lifetimes (seconds) and HttpOnly cookie settings.
# Secure defaults to true in production. SameSite=none needs Secure in browsers.
JWT_ACCESS_EXPIRES_IN_SEC=
JWT_REFRESH_EXPIRES_IN_SEC=
ACCESS_TOKEN_COOKIE_NAME=
ACCESS_TOKEN_COOKIE_SECURE=
ACCESS_TOKEN_COOKIE_SAMESITE=
ACCESS_TOKEN_COOKIE_DOMAIN=
REFRESH_TOKEN_COOKIE_NAME=
REFRESH_TOKEN_COOKIE_SECURE=
REFRESH_TOKEN_COOKIE_SAMESITE=
REFRESH_TOKEN_COOKIE_DOMAIN=

# Optional Telegram initData replay window (seconds) and admin feedback.
TELEGRAM_INIT_DATA_MAX_AGE_SEC=
SHOULD_SEND_GIG_SUBMISSION_FEEDBACK_TO_ADMINS=

# Google Calendar integration: configure the calendar and exactly one credential source.
CALENDAR_ID=
# Local service account JSON file path.
GOOGLE_APPLICATION_CREDENTIALS=
#Raw/base64 service account JSON.
# Leave this empty when GOOGLE_APPLICATION_CREDENTIALS is used.
GOOGLE_AUTH_JSON=

# S3-compatible storage. Optional at API startup; requirements below apply to storage.
# Required for poster uploads.
S3_BUCKET=
# Required for R2/custom endpoints; optional for standard AWS S3.
S3_ENDPOINT=
# Required together unless credentials are supplied by the AWS SDK credential chain.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional override. Default: auto (R2); other providers may need a region.
S3_REGION=
# Optional. Default: false.
S3_FORCE_PATH_STYLE=
# Optional. Default: gigs.
S3_POSTERS_PREFIX=
# Required for public bucket/CDN poster URLs.
S3_PUBLIC_BASE_URL=

# Optional CORS mode/allowlist.
CORS_ORIGINS=

# Poster fallback settings.
EXTERNAL_POSTER_URL_FALLBACK_ENABLED=
# Direct public image URL for flows requiring a default poster.
# Should be a direct, publicly accessible image URL.
DEFAULT_GIG_POSTER_URL=

# Real AI lookup requires all three provider settings.
AI_URL=
AI_API_KEY=
AI_MODEL=
AI_LOOKUP_DEBUG=
# Non-production stub for POST /v1/admin/gig-candidates/lookup.
# The keyword can activate the stub independently of the flag; both are ignored in production.
# TODO: Make AI_LOOKUP_DEV_STUB=false disable the stub despite keyword matches.
# When true, use AI_LOOKUP_DEV_STUB_KEYWORD only as an optional filter.
# TODO: Supply an explicit deployment environment so the backend can identify staging.
# With NODE_ENV=prod/production, staging is indistinguishable from production.
AI_LOOKUP_DEV_STUB=
AI_LOOKUP_DEV_STUB_KEYWORD=

# Frontend links and on-demand cache revalidation.
APP_BASE_URL=
# Each secret must match the corresponding server-only frontend value.
FEED_REVALIDATE_SECRET=
TRANSLATIONS_REVALIDATE_SECRET=
